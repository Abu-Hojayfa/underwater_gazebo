<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="auv_placeholder">
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>25.0000</mass>
        <inertia>
          <ixx>0.5208</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.5208</iyy><iyz>0</iyz>
          <izz>1.6667</izz>
        </inertia>
      </inertial>

      <!-- Main Hull body -->
      <visual name="hull_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8000 0.4000 0.3000</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9500 0.8000 0.0500 1.0000</ambient>
          <diffuse>0.9500 0.8000 0.0500 1.0000</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
        </material>
      </visual>
      <collision name="hull_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8000 0.4000 0.3000</size>
          </box>
        </geometry>
      </collision>

      <!-- Forward Optical Sensor Dome (Heading indicator) -->
      <visual name="bow_dome_visual">
        <pose>0.4000 0 0 0 1.570796 0</pose>
        <geometry>
          <sphere>
            <radius>0.1200</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 0.8</ambient>
          <diffuse>0.1 0.1 0.1 0.8</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>

      <!-- Heading Directional Arrow on Top Deck -->
      <visual name="heading_arrow">
        <pose>0.2000 0 0.1550 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2667 0.05 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.05 0.05 1.0</ambient>
          <diffuse>0.85 0.05 0.05 1.0</diffuse>
        </material>
      </visual>

      <!-- Downward Camera Well -->
      <visual name="down_cam_visual">
        <pose>0 0 -0.1700 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>

      <!-- Port Thruster Ducts -->
      <visual name="thruster_port_visual">
        <pose>0 -0.2600 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1.0</ambient><diffuse>0.15 0.15 0.15 1.0</diffuse></material>
      </visual>
      <collision name="thruster_port_col">
        <pose>0 -0.2600 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.16</length></cylinder></geometry>
      </collision>

      <!-- Starboard Thruster Ducts -->
      <visual name="thruster_stbd_visual">
        <pose>0 0.2600 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1.0</ambient><diffuse>0.15 0.15 0.15 1.0</diffuse></material>
      </visual>
      <collision name="thruster_stbd_col">
        <pose>0 0.2600 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.16</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>

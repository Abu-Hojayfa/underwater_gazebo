<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="buoy">
    <static>true</static>
    <link name="buoy_link">
      <!-- Floor Anchor -->
      <visual name="anchor_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      <collision name="anchor_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Tether cable -->
      <visual name="cable_visual">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>2.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>
      <collision name="cable_collision">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>2.0</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Spherical target buoy body -->
      <visual name="sphere_visual">
        <pose>0 0 2.0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.20</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.1 1.0</ambient>
          <diffuse>0.9 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
      <collision name="sphere_collision">
        <pose>0 0 2.0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.20</radius>
          </sphere>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>

<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="slalom_pole">
    <static>true</static>
    <link name="pole_link">
      <!-- Weighted mooring base -->
      <visual name="base_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2000</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      <collision name="base_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2000</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Vertical slalom pole body -->
      <visual name="pole_visual">
        <pose>0 0 1.1000 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0300</radius>
            <length>2.2000</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1.0</ambient>
          <diffuse>0.95 0.95 0.95 1.0</diffuse>
        </material>
      </visual>
      <collision name="pole_collision">
        <pose>0 0 1.1000 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0300</radius>
            <length>2.2000</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- High-visibility pole top cap -->
      <visual name="top_cap_visual">
        <pose>0 0 2.2500 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.0450</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.88 0.08 0.08 1.0</ambient>
          <diffuse>0.88 0.08 0.08 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

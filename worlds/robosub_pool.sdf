<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="robosub_pool_world">
    <!-- Physics parameters -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Sim System Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1000.0</uniform_fluid_density>
    </plugin>

    <!-- Underwater Scene & Lighting settings -->
    <scene>
      <ambient>0.3500 0.5500 0.6500 1.0000</ambient>
      <background>0.0500 0.2500 0.3500 1.0000</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Surface Penetrating Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>10.0 0.0 10.0 0 0 0</pose>
      <diffuse>0.7500 0.8800 0.9500 1.0000</diffuse>
      <specular>0.2500 0.2500 0.2500 1.0000</specular>
      <direction>-0.3 0.2 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Underwater Pool Model -->
    <include>
      <name>pool</name>
      <uri>model://pool</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Starting Gate -->
    <include>
      <name>starting_gate</name>
      <uri>model://gate</uri>
      <pose>3.5000 0.0000 2.5000 0 0 0</pose>
    </include>

    <!-- Slalom Obstacle Poles -->
    
    <!-- slalom_pole_1 -->
    <include>
      <name>slalom_pole_1</name>
      <uri>model://slalom_pole</uri>
      <pose>6.5000 -1.0000 0 0 0 0</pose>
    </include>
    <!-- slalom_pole_2 -->
    <include>
      <name>slalom_pole_2</name>
      <uri>model://slalom_pole</uri>
      <pose>7.5000 0.0000 0 0 0 0</pose>
    </include>
    <!-- slalom_pole_3 -->
    <include>
      <name>slalom_pole_3</name>
      <uri>model://slalom_pole</uri>
      <pose>8.5000 1.0000 0 0 0 0</pose>
    </include>
    <!-- slalom_pole_4 -->
    <include>
      <name>slalom_pole_4</name>
      <uri>model://slalom_pole</uri>
      <pose>9.5000 -1.0000 0 0 0 0</pose>
    </include>
    <!-- slalom_pole_5 -->
    <include>
      <name>slalom_pole_5</name>
      <uri>model://slalom_pole</uri>
      <pose>10.5000 0.0000 0 0 0 0</pose>
    </include>
    <!-- slalom_pole_6 -->
    <include>
      <name>slalom_pole_6</name>
      <uri>model://slalom_pole</uri>
      <pose>11.5000 1.0000 0 0 0 0</pose>
    </include>

    <!-- Buoys -->
    
    <!-- buoy_red -->
    <include>
      <name>buoy_red</name>
      <uri>model://buoy</uri>
      <pose>12.8000 -1.8000 0 0 0 0</pose>
    </include>
    <!-- buoy_green -->
    <include>
      <name>buoy_green</name>
      <uri>model://buoy</uri>
      <pose>12.8000 -0.9000 0 0 0 0</pose>
    </include>
    <!-- buoy_yellow -->
    <include>
      <name>buoy_yellow</name>
      <uri>model://buoy</uri>
      <pose>12.8000 0.0000 0 0 0 0</pose>
    </include>

    <!-- Path Navigation Markers -->
    
    <!-- path_marker_1 -->
    <include>
      <name>path_marker_1</name>
      <uri>model://path_marker</uri>
      <pose>4.8000 0.0000 0.0100 0 0 0.0000</pose>
    </include>
    <!-- path_marker_2 -->
    <include>
      <name>path_marker_2</name>
      <uri>model://path_marker</uri>
      <pose>12.2000 -0.6000 0.0100 0 0 -0.4500</pose>
    </include>
    <!-- path_marker_3 -->
    <include>
      <name>path_marker_3</name>
      <uri>model://path_marker</uri>
      <pose>15.8000 0.0000 0.0100 0 0 0.3500</pose>
    </include>

    <!-- Recon Target Bins -->
    <include>
      <name>target_bins</name>
      <uri>model://target_bin</uri>
      <pose>14.0000 -2.0000 0.1500 0 0 0</pose>
    </include>

    <!-- Torpedo Target Board -->
    <include>
      <name>target_board</name>
      <uri>model://target_board</uri>
      <pose>14.2000 2.0000 1.5000 0.0000 0.0000 3.1416</pose>
    </include>

    <!-- Octagonal Mission / Resupply Zone -->
    <include>
      <name>octagon_zone</name>
      <uri>model://octagon_zone</uri>
      <pose>17.5000 0.0000 0.0150 0 0 0</pose>
    </include>

    <!-- Generic AUV Model Placeholder -->
    <include>
      <name>auv_reference</name>
      <uri>model://auv_placeholder</uri>
      <pose>1.0000 0.0000 2.5000 0.0000 0.0000 0.0000</pose>
    </include>
  </world>
</sdf>
